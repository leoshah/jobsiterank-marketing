  }
  .legal-prose h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .legal-prose p {
    color: var(--color-slate-700);
    margin-top: 1rem;
    margin-bottom: 0;
    line-height: 1.7;
  }
  .legal-prose ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose li {
    margin-top: 0.25rem;
    color: var(--color-slate-700);
  }
  .legal-prose a {
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose a:hover {
    color: var(--color-ink);
  }
  .legal-prose strong {
